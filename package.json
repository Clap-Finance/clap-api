{
  "name": "clap-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.spec.json"
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "*",
    "@nestjs/config": "*",
    "@nestjs/core": "*",
    "@nestjs/jwt": "*",
    "@nestjs/passport": "*",
    "@nestjs/platform-express": "*",
    "@nestjs/swagger": "*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "*",
    "argon2": "*",
    "class-transformer": "*",
    "class-validator": "*",
    "passport": "*",
    "passport-jwt": "*",
    "pg": "^8.22.0",
    "reflect-metadata": "*",
    "rxjs": "*",
    "uuid": "*"
  },
  "devDependencies": {
    "@nestjs/cli": "*",
    "@types/jest": "^30.0.0",
    "@types/node": "*",
    "@types/passport-jwt": "*",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "*",
    "jest": "^30.4.2",
    "prisma": "*",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "*",
    "typescript": "^6.0.3"
  }
}
